library(papercheck)
library(tidyverse)
theme_set(theme_minimal(13))
knitr::opts_chunk$set(echo = TRUE)
paper <- read("papers/debruine-fret.xml")
paper
papers <- read("papers")
search_text(paper, "*", return = "sentence")
search_text(paper, "Canada", return = "sentence")
search_text(paper, "repro", return = "sentence")
search_text(paper, "significan", return = "sentence")
search_text(paper, "standard", return = "sentence")
search_text(paper, "morphing", return = "sentence")
search_text(paper, "\\S+\\s*=\\s*[0-9\\.]+", return = "sentence")
search_text(paper, "\\S+\\s*=\\s*[0-9\\.]+", return = "match")
search_text(paper, "\\S+\\s*=\\s*\\S+", return = "match")
search_text(paper, "\\b\\S+\\s*=\\s*\\S+", return = "match")
search_text(paper, "\\b\\S+\\s*=\\s*\\S+\\b", return = "match")
search_text(paper, "morph", return = "match")
search_text(paper, "morph")
search_text(paper, "Canadian")
search_text(paper, "Canadian") |> knitr::kable()
search_text(paper, "\\b\\S+\\s*=\\s*\\S+\\b", return = "match") |> knitr::kable()
papers
